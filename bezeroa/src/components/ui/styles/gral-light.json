{
  "rules": [
    { "token": "comment", "foreground": "64748b", "fontStyle": "italic" },
    { "token": "keyword", "foreground": "9a3412" },
    { "token": "string", "foreground": "0f766e" },
    { "token": "number", "foreground": "7e22ce" },
    { "token": "type", "foreground": "1e3a8a" }
  ],
  "colors": {
