    "editor.foreground": "#0f172a",
    "editor.lineHighlightBackground": "#cbd5e1",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#fed7aa80",
    "editorCursor.foreground": "#c2410c",
    "editorGutter.background": "#e2e8f0",
    "editorIndentGuide.activeBackground1": "#94a3b8",
    "editorIndentGuide.background1": "#cbd5e1",
    "editorLineNumber.activeForeground": "#1e293b",
    "editorLineNumber.foreground": "#94a3b8",
    "scrollbarSlider.activeBackground": "#475569cc",
    "scrollbarSlider.background": "#94a3b866",
    "scrollbarSlider.hoverBackground": "#64748baa"
  }
}
