{
  "name": "@gral/zerbitzaria",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run db:generate && tsup",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:seed": "npm run db:deploy && npm run db:seed",
    "db:generate": "prisma generate",
    "db:generate:dev": "cross-env NODE_ENV=development npm run db:generate",
    "db:migrate": "cross-env NODE_ENV=development prisma migrate dev && cross-env NODE_ENV=development npm run db:generate",
    "db:migrate:seed": "cross-env NODE_ENV=development npm run db:migrate && cross-env NODE_ENV=development npm run db:seed",
    "db:reset": "cross-env NODE_ENV=development npm run db:reset:noseed && cross-env NODE_ENV=development npm run db:seed",
    "db:reset:noseed": "cross-env NODE_ENV=development prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "cross-env NODE_ENV=development prisma studio",
    "dev": "npm run dev:watch",
    "dev:basic": "cross-env NODE_ENV=development tsx -C dev src/main.ts",
    "dev:watch": "cross-env NODE_ENV=development tsx watch -C dev src/main.ts",
    "start": "node dist/main.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "node-cron": "^4.2.1",
    "openai": "^6.38.0",
    "pg": "^8.20.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "prisma": "^7.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
